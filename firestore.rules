rules_version = '2';

// Admin identity: the login screen (a single password field, per spec 4.0) signs
// in behind the scenes with a fixed Firebase Auth account. `request.auth.uid`
// counting as "admin" is determined by the existence of admins/{uid} — that
// collection is never client-writable, so nobody can self-promote by creating
// a Firebase Auth account and writing their own uid into it.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Existence-only lookup table for isAdmin(). exists() bypasses these
    // read/write rules during rule evaluation, so locking both down entirely
    // is safe and intentional — no client ever needs direct access to this.
    match /admins/{adminId} {
      allow read, write: if false;
    }

    match /registrations/{registrationId} {
      // Public registration flow: anyone can create their own registration,
      // read to look up/QR-checkin, and delete (등록 취소) with just the
      // document id or a name+phone match — matches spec's no-account design.
      allow read, create, delete: if true;

      // Self-edit (등록 정보 수정) stays open the same way, but payment status
      // and check-in state can only change through an authenticated admin.
      allow update: if isAdmin() ||
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['paymentStatus', 'checkedIn', 'checkedInAt']);
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
