rules_version = '2';

// Admin identity: the login screen (a single password field) signs in behind
// the scenes with a fixed Firebase Auth account. `request.auth.uid` counting
// as "admin" is determined by the existence of admins/{uid} — that collection
// is never client-writable, so nobody can self-promote by creating a Firebase
// Auth account and writing their own uid into it.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Existence-only lookup table for isAdmin(). exists() bypasses these
    // read/write rules during rule evaluation, so locking both down entirely
    // is safe and intentional — no client ever needs direct access to this.
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // 무기명 설문: 누구나 제출(create)할 수 있지만, 제출 후에는 수정·삭제할 수 없다.
    // 응답 열람은 관리자만 가능 (설문 응답 원문 자체는 저장하지 않고, PDF가 저장된
    // Storage 경로만 색인한다).
    match /surveyResponses/{responseId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
